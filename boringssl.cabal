cabal-version:   3.14
name:            boringssl
version:         0.1.0.0
license:         Apache-2.0
license-file:    LICENSE
author:          Samuel Schlesinger
maintainer:      sgschlesinger@gmail.com
build-type:      Simple
extra-doc-files: CHANGELOG.md
synopsis:        Bindings to Google's BoringSSL library
description:     Bindings to Google's BoringSSL library.

common warnings
    ghc-options: -Wall -Werror

