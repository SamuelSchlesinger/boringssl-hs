test-suite boringssl-test
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Main.hs
    other-modules:
        Test.Digest
        Test.AEAD
        Test.HMAC
        Test.HKDF
        Test.Random
        Test.Cipher
        Test.Ed25519
        Test.X25519
        Test.ECDSA
        Test.ECDH
        Test.RSA
        Test.Base64
        Test.PBKDF2
        Test.MLKEM
        Test.MLDSA
        Test.X509
        Test.PEM
        Test.HPKE
        Test.SPAKE2
        Test.TrustToken
        Test.Properties
    build-depends:
        base ^>=4.18.3.0,
        bytestring >=0.11 && <0.13,
        boringssl,
        tasty >=1.4,
        tasty-hunit >=0.10,
        tasty-quickcheck >=0.10,
        base16-bytestring >=1.0
    hs-source-dirs:   test
    default-language: Haskell2010

benchmark boringssl-bench
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Main.hs
    hs-source-dirs:   bench
    build-depends:
        base ^>=4.18.3.0,
        bytestring >=0.11 && <0.13,
        boringssl,
        criterion >=1.5
    default-language: Haskell2010
