        Crypto.BoringSSL.Internal.Error
    build-depends:
        base ^>=4.18.3.0,
        bytestring >=0.11 && <0.13
    hs-source-dirs:   src
    default-language: Haskell2010
    include-dirs:     third_party/boringssl/include
    c-sources:        cbits/trust_token_helpers.c
    cc-options:       -DOPENSSL_NO_ASM -DBORINGSSL_IMPLEMENTATION
    cxx-options:      -std=c++17 -DOPENSSL_NO_ASM -DBORINGSSL_IMPLEMENTATION -fno-exceptions -fno-rtti
    if os(darwin)
        extra-libraries: c++
    if os(linux)
        extra-libraries: stdc++ pthread
        cxx-options:     -D_XOPEN_SOURCE=700
